# Optional. When set, feedback and early-access submissions are POSTed
# as JSON to this URL. When unset, they are kept in the visitor's browser only.
NEXT_PUBLIC_SUBMIT_ENDPOINT=

# Canonical site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://gridopslabs.com

# ---------------------------------------------------------------------------
# Utility inquiry (contact) email — server-side only (see src/app/api/lead).
# When RESEND_API_KEY is absent, leads are accepted and logged server-side but
# not emailed. Set all three in production to deliver to the inbox below.
# ---------------------------------------------------------------------------
# Resend API key (server secret — never exposed to the browser).
RESEND_API_KEY=
# Where inquiries are delivered.
LEAD_TO_EMAIL=info@sentinelpeaksolutions.com
# Verified sender. Must be on a domain verified in Resend, e.g.
# "GridOps Labs <leads@gridopslabs.com>". Defaults to Resend's test sender.
LEAD_FROM_EMAIL=
